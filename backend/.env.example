# MongoDB Atlas Connection String (use existing variable name dbURL)
dbURL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# JWT Authentication Secret (use existing variable name jwt_secret)
jwt_secret=your_jwt_secret_key_here

# Razorpay Payment Gateway Credentials
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Frontend Application Origin (for CORS and credentials)
# In production on Render: set to your Vercel URL (e.g. https://your-shopkart.vercel.app)
# In local development: http://localhost:5173
CLIENT_URL=http://localhost:5173

# Server Environment & Port (Render dynamically assigns PORT)
NODE_ENV=development
PORT=8081
